rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de listings: solo el dueño puede subir, todos los usuarios autenticados pueden leer
    match /listings/{listingId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // max 5MB por foto
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
